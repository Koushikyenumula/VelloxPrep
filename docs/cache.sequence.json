{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "API Request with Cache Miss",
    "output": "cache-miss.html",
    "viewBox": [1080, 580],
    "column_fit": "spread",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "participants": [
    { "id": "browser", "type": "external", "label": "Browser", "sublabel": "Client UI" },
    { "id": "api", "type": "backend", "label": "API Server", "sublabel": "Spring Boot" },
    { "id": "redis", "type": "database", "label": "Redis", "sublabel": "In-Memory Cache" },
    { "id": "postgres", "type": "database", "label": "PostgreSQL", "sublabel": "Relational DB" }
  ],
  "segments": [
    { "from": 150, "to": 250, "label": "API Request" },
    { "from": 260, "to": 370, "label": "Cache Check & Fallback" },
    { "from": 380, "to": 480, "label": "Response" }
  ],
  "messages": [
    { "id": "req", "from": "browser", "to": "api", "y": 185, "label": "GET /data", "variant": "emphasis" },
    { "id": "cache-read", "from": "api", "to": "redis", "y": 270, "label": "GET key", "variant": "default" },
    { "id": "cache-miss", "from": "redis", "to": "api", "y": 298, "label": "miss (null)", "variant": "return" },
    { "id": "db-query", "from": "api", "to": "postgres", "y": 330, "label": "SELECT data", "variant": "emphasis" },
    { "id": "db-rows", "from": "postgres", "to": "api", "y": 358, "label": "rows", "variant": "return" },
    { "id": "cache-write", "from": "api", "to": "redis", "y": 390, "label": "SET key data", "variant": "dashed" },
    { "id": "res", "from": "api", "to": "browser", "y": 443, "label": "200 OK (JSON)", "variant": "return" }
  ],
  "activations": [
    { "participant": "api", "from": 185, "to": 450, "type": "backend" },
    { "participant": "redis", "from": 265, "to": 304, "type": "database" },
    { "participant": "postgres", "from": 325, "to": 364, "type": "database" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Cache Check",
      "items": [
        "The API first attempts to read from the fast in-memory Redis cache."
      ]
    },
    {
      "dot": "rose",
      "title": "Cache Miss Fallback",
      "items": [
        "If Redis returns a miss, the API falls back to querying PostgreSQL.",
        "This acts as the source of truth."
      ]
    },
    {
      "dot": "orange",
      "title": "Cache Hydration",
      "items": [
        "After fetching the data from Postgres, the API writes it back to Redis.",
        "Future requests will now hit the cache."
      ]
    }
  ]
}
